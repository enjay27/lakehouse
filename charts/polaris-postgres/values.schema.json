{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["instances", "image", "podAntiAffinityType", "storage", "database", "owner",
               "credentialsSecret"],
  "properties": {
    "instances": {"type": "integer", "minimum": 1},
    "image": {"type": "string", "pattern": "^[^@\\s]+:[^@\\s]+@sha256:[0-9a-f]{64}$"},
    "podAntiAffinityType": {"enum": ["required", "preferred"]},
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size": {"type": "string", "minLength": 1},
        "storageClass": {"type": "string"}
      }
    },
    "database": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "credentialsSecret": {"type": "string", "minLength": 1}
  }
}
