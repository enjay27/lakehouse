{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "schedule", "timeZone", "polaris", "securityContext",
               "activeDeadlineSeconds", "successfulJobsHistoryLimit", "failedJobsHistoryLimit",
               "resources"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]}
      }
    },
    "schedule": {"type": "string", "pattern": "^\\S+ \\S+ \\S+ \\S+ \\S+$"},
    "timeZone": {"type": "string", "minLength": 1},
    "polaris": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logsClaim", "logsDir", "podPrefix", "podSelector"],
      "properties": {
        "logsClaim": {"type": "string", "minLength": 1},
        "logsDir": {"type": "string", "pattern": "^/"},
        "podPrefix": {"type": "string", "minLength": 1},
        "podSelector": {"type": "string", "minLength": 1}
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runAsUser", "runAsGroup", "fsGroup"],
      "properties": {
        "runAsUser": {"type": "integer", "minimum": 1},
        "runAsGroup": {"type": "integer", "minimum": 1},
        "fsGroup": {"type": "integer", "minimum": 1}
      }
    },
    "activeDeadlineSeconds": {"type": "integer", "minimum": 60},
    "successfulJobsHistoryLimit": {"type": "integer", "minimum": 0},
    "failedJobsHistoryLimit": {"type": "integer", "minimum": 0},
    "resources": {"type": "object"}
  }
}
