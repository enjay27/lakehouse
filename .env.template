# Copy to .env with `python3 scripts/init_env.py` (gitignored). Only this template is
# committed (ADR-002). Values here are examples or empty; no credential, hostname or URL of a
# real system.

# Kubernetes context of your Linux test cluster. No default: the scripts stop while it is
# empty (ADR-004).
KUBE_CONTEXT=

# Namespaces of what this repository builds (ADR-007, ADR-031).
NS_CNPG_SYSTEM=cnpg-system
NS_CATALOG_POLARIS=catalog-polaris
NS_CATALOG_DATAHUB=catalog-datahub
# Stand-ins for other teams' services, on the gate and test clusters only (ADR-031).
NS_STANDINS=standins

# Callers in other teams' namespaces that may reach Polaris (ADR-048): one namespace label each,
# key=value, as the cluster you install into sets it. Empty: no namespace of that class may
# connect, and the install says so.
# The catalog gateway's namespace, and user namespaces (StarRocks): Polaris's API.
POLARIS_GATEWAY_NAMESPACE_LABEL=
POLARIS_QUERY_NAMESPACE_LABEL=
# The metrics scraper's namespace: Polaris's management port.
METRICS_NAMESPACE_LABEL=
# The ingress controller's namespace: the console and, while it is enabled, Polaris's API.
INGRESS_NAMESPACE_LABEL=

# Other teams' services: endpoints of the environment you install into (ADR-031).
S3_ENDPOINT=
S3_REGION=
POLARIS_WAREHOUSE_BUCKET=
# The bucket Polaris's PostgreSQL backs up to, on the same S3 endpoint (ADR-043).
POLARIS_BACKUP_BUCKET=
POLARIS_OPA_URL=
DATAHUB_OIDC_ISSUER_URL=

# The host Polaris connects to for its PostgreSQL; empty means the Cluster's read-write
# service, polaris-pg-rw. The gate names its recorder here (ADR-034).
POLARIS_DB_HOST=

# The claim Polaris writes its log files to and the log batch reads (ADR-036): a
# ReadWriteMany storage class of the cluster you install into, and the claim's size. No
# default: the install stops while either is empty.
POLARIS_LOGS_STORAGE_CLASS=
POLARIS_LOGS_SIZE=

# The registry and path the cluster pulls this repository's images from (ADR-042): empty
# means ghcr.io/enjay27/lakehouse, where the release workflow pushes them. A mirror holds them
# under the same name and tag, for example <mirror>/<path>/polaris-log-batch:<tag>.
IMAGE_REGISTRY=

# The Polaris console, a maintainer tool (ADR-028): off unless `true`. Its origin is the URL
# maintainers open it at, which Polaris allows (CORS) only while the console is enabled; the
# API URL is where their browser reaches Polaris.
POLARIS_CONSOLE_ENABLED=false
POLARIS_CONSOLE_ORIGIN=
POLARIS_CONSOLE_API_URL=

# Credentials for other teams' services: typed in by hand, never generated (ADR-031).
POLARIS_S3_ACCESS_KEY_ID=
POLARIS_S3_SECRET_ACCESS_KEY=
# The smoke tests' own S3 key, for PyIceberg: read and write in the warehouse bucket only.
SMOKE_S3_ACCESS_KEY_ID=
SMOKE_S3_SECRET_ACCESS_KEY=
# The backups' own S3 key, never Polaris's: read, write and list the backup bucket (ADR-043).
POLARIS_BACKUP_S3_ACCESS_KEY_ID=
POLARIS_BACKUP_S3_SECRET_ACCESS_KEY=

# Credentials this repository creates: generated per clone by init_env.py (ADR-006, ADR-026).
# Leave empty here.
POLARIS_DB_PASSWORD=
POLARIS_ROOT_CLIENT_ID=
POLARIS_ROOT_CLIENT_SECRET=
POLARIS_TOKEN_SIGNING_KEY=
DATAHUB_DB_PASSWORD=
