# Copy to .env (gitignored) and fill in. Only this template is committed (ADR-002).
# Values here are examples or empty; no credential, hostname or URL of a real system.

# Kubernetes context the install scripts refuse to run without (ADR-004).
KUBE_CONTEXT=orbstack

# Namespaces by service type (ADR-007).
NS_CNPG_SYSTEM=cnpg-system
NS_STORAGE=storage
NS_CATALOG_POLARIS=catalog-polaris
NS_CATALOG_DATAHUB=catalog-datahub
NS_MONITORING=monitoring

# Credentials: created as Kubernetes Secrets at install time, never written to a values
# file (ADR-006). Leave empty here.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
POLARIS_DB_PASSWORD=
POLARIS_ROOT_CLIENT_ID=
POLARIS_ROOT_CLIENT_SECRET=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
