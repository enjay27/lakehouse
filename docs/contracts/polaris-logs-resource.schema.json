{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polaris log contract v2: a resource row",
  "description": "A resource row of aggregated-logs/YYYYMMDD-HH.jsonl: the access lines of one resource in the hour, counted, kept or not; __errors__ and __other__ collect what the row caps send there (docs/contracts/polaris-logs.md, ADR-036).",
  "type": "object",
  "required": [
    "contract_version",
    "report_type",
    "window_start",
    "window_end",
    "window_seconds",
    "resource",
    "resource_kind",
    "api_kind",
    "requests",
    "reads",
    "writes",
    "errors",
    "errors_4xx",
    "errors_5xx",
    "auth_denied",
    "response_bytes"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 2
    },
    "report_type": {
      "const": "resource"
    },
    "window_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$"
    },
    "window_seconds": {
      "const": 3600
    },
    "resource": {
      "type": "string"
    },
    "resource_kind": {
      "type": "string",
      "enum": [
        "principal-role",
        "catalog-role",
        "collection",
        "auth",
        "config",
        "table",
        "view",
        "transaction",
        "namespace",
        "catalog",
        "principal",
        "other",
        "error"
      ]
    },
    "api_kind": {
      "type": "string",
      "enum": [
        "management",
        "catalog",
        "other",
        "mixed"
      ]
    },
    "requests": {
      "type": "integer",
      "minimum": 0
    },
    "reads": {
      "type": "integer",
      "minimum": 0
    },
    "writes": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "errors_4xx": {
      "type": "integer",
      "minimum": 0
    },
    "errors_5xx": {
      "type": "integer",
      "minimum": 0
    },
    "auth_denied": {
      "type": "integer",
      "minimum": 0
    },
    "response_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "last_read_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "last_write_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "commit_count": {
      "type": "integer",
      "minimum": 0
    },
    "commit_ms_sum": {
      "type": "integer",
      "minimum": 0
    },
    "commit_ms_min": {
      "type": "integer",
      "minimum": 0
    },
    "commit_ms_max": {
      "type": "integer",
      "minimum": 0
    }
  }
}
