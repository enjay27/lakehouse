{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polaris log contract v2: a principal row",
  "description": "A principal row of aggregated-logs/YYYYMMDD-HH.jsonl: the access lines of one caller in the hour; `-` for none, __other__ past the cap (docs/contracts/polaris-logs.md, ADR-036).",
  "type": "object",
  "required": [
    "contract_version",
    "report_type",
    "window_start",
    "window_end",
    "window_seconds",
    "user_principal_name",
    "requests",
    "reads",
    "writes",
    "errors",
    "errors_4xx",
    "errors_5xx",
    "auth_denied",
    "response_bytes"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 2
    },
    "report_type": {
      "const": "principal"
    },
    "window_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$"
    },
    "window_seconds": {
      "const": 3600
    },
    "user_principal_name": {
      "type": "string"
    },
    "requests": {
      "type": "integer",
      "minimum": 0
    },
    "reads": {
      "type": "integer",
      "minimum": 0
    },
    "writes": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "errors_4xx": {
      "type": "integer",
      "minimum": 0
    },
    "errors_5xx": {
      "type": "integer",
      "minimum": 0
    },
    "auth_denied": {
      "type": "integer",
      "minimum": 0
    },
    "response_bytes": {
      "type": "integer",
      "minimum": 0
    }
  }
}
