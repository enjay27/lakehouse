{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polaris log contract v2: an app_dropped row",
  "description": "An app_dropped row of aggregated-logs/YYYYMMDD-HH.jsonl: how many lines of one application logger the policy dropped in the hour; __other__ past the cap (docs/contracts/polaris-logs.md, ADR-036).",
  "type": "object",
  "required": [
    "contract_version",
    "report_type",
    "window_start",
    "window_end",
    "window_seconds",
    "logger_name",
    "dropped"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 2
    },
    "report_type": {
      "const": "app_dropped"
    },
    "window_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$"
    },
    "window_seconds": {
      "const": 3600
    },
    "logger_name": {
      "type": "string"
    },
    "dropped": {
      "type": "integer",
      "minimum": 1
    }
  }
}
