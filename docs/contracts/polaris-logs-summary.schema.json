{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polaris log contract v2: the summary row",
  "description": "The first line of aggregated-logs/YYYYMMDD-HH.jsonl: the batch's account of the hour and the audit policy's counters. The batch writes the file last: once it exists, the hour is complete (docs/contracts/polaris-logs.md, ADR-036).",
  "type": "object",
  "required": [
    "contract_version",
    "report_type",
    "window_start",
    "window_end",
    "window_seconds",
    "hour",
    "policy",
    "lines_in",
    "processed",
    "dropped",
    "malformed",
    "pods",
    "by_pod",
    "sources",
    "corrupt_files",
    "orphans_moved",
    "idle_log_files",
    "pod_list_error",
    "access_seen",
    "access_kept",
    "access_counted",
    "role_keys_forced",
    "counted_read",
    "counted_post",
    "errors_kept",
    "parse_errors",
    "errors_4xx",
    "errors_5xx",
    "auth_denied",
    "bytes_total",
    "distinct_resources",
    "distinct_principals",
    "resources_other",
    "resources_other_distinct",
    "principals_other",
    "app_dropped_total",
    "counted_404",
    "app_dropped_404",
    "held_orphans",
    "message",
    "published_at"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 2
    },
    "report_type": {
      "const": "summary"
    },
    "window_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$"
    },
    "window_seconds": {
      "const": 3600
    },
    "hour": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{2}$"
    },
    "policy": {
      "const": "policy-v5"
    },
    "lines_in": {
      "type": "integer",
      "minimum": 0
    },
    "processed": {
      "type": "integer",
      "minimum": 0
    },
    "dropped": {
      "type": "integer",
      "minimum": 0
    },
    "malformed": {
      "type": "integer",
      "minimum": 0
    },
    "pods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "by_pod": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "lines"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "lines": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "corrupt_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "orphans_moved": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "file",
          "pod",
          "last_line_hour"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "pod": {
            "type": "string"
          },
          "last_line_hour": {
            "type": "string",
            "pattern": "^[0-9]{8}-[0-9]{2}$"
          },
          "unterminated_tail": {
            "type": "boolean"
          }
        }
      }
    },
    "idle_log_files": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "file",
          "pod",
          "last_line_hour"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "pod": {
            "type": "string"
          },
          "last_line_hour": {
            "type": "string",
            "pattern": "^[0-9]{8}-[0-9]{2}$"
          },
          "unterminated_tail": {
            "type": "boolean"
          }
        }
      }
    },
    "pod_list_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "access_seen": {
      "type": "integer",
      "minimum": 0
    },
    "access_kept": {
      "type": "integer",
      "minimum": 0
    },
    "access_counted": {
      "type": "integer",
      "minimum": 0
    },
    "role_keys_forced": {
      "type": "integer",
      "minimum": 0
    },
    "counted_read": {
      "type": "integer",
      "minimum": 0
    },
    "counted_post": {
      "type": "integer",
      "minimum": 0
    },
    "errors_kept": {
      "type": "integer",
      "minimum": 0
    },
    "parse_errors": {
      "type": "integer",
      "minimum": 0
    },
    "errors_4xx": {
      "type": "integer",
      "minimum": 0
    },
    "errors_5xx": {
      "type": "integer",
      "minimum": 0
    },
    "auth_denied": {
      "type": "integer",
      "minimum": 0
    },
    "bytes_total": {
      "type": "integer",
      "minimum": 0
    },
    "distinct_resources": {
      "type": "integer",
      "minimum": 0
    },
    "distinct_principals": {
      "type": "integer",
      "minimum": 0
    },
    "resources_other": {
      "type": "integer",
      "minimum": 0
    },
    "resources_other_distinct": {
      "type": "integer",
      "minimum": 0
    },
    "principals_other": {
      "type": "integer",
      "minimum": 0
    },
    "app_dropped_total": {
      "type": "integer",
      "minimum": 0
    },
    "counted_404": {
      "type": "integer",
      "minimum": 0
    },
    "app_dropped_404": {
      "type": "integer",
      "minimum": 0
    },
    "held_orphans": {
      "type": "integer",
      "minimum": 0
    },
    "min_record_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "max_record_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "message": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$"
    }
  }
}
