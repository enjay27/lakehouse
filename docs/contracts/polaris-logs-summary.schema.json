{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polaris log contract v1: the summary row",
  "description": "The one line of aggregated-logs/YYYYMMDD-HH.jsonl. The batch writes it last: once it exists, the hour is complete (docs/contracts/polaris-logs.md, ADR-036).",
  "type": "object",
  "required": [
    "contract_version",
    "report_type",
    "hour",
    "window_start",
    "window_end",
    "lines_in",
    "processed",
    "malformed",
    "pods",
    "by_pod",
    "sources",
    "corrupt_files",
    "orphans_moved",
    "idle_log_files",
    "pod_list_error",
    "published_at"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 1
    },
    "report_type": {
      "const": "summary"
    },
    "hour": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{2}$"
    },
    "window_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$"
    },
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$"
    },
    "lines_in": {
      "type": "integer",
      "minimum": 0
    },
    "processed": {
      "type": "integer",
      "minimum": 0
    },
    "malformed": {
      "type": "integer",
      "minimum": 0
    },
    "pods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "by_pod": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "lines"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "lines": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "corrupt_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "orphans_moved": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "file",
          "pod",
          "last_line_hour"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "pod": {
            "type": "string"
          },
          "last_line_hour": {
            "type": "string",
            "pattern": "^[0-9]{8}-[0-9]{2}$"
          },
          "unterminated_tail": {
            "type": "boolean"
          }
        }
      }
    },
    "idle_log_files": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "file",
          "pod",
          "last_line_hour"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "pod": {
            "type": "string"
          },
          "last_line_hour": {
            "type": "string",
            "pattern": "^[0-9]{8}-[0-9]{2}$"
          },
          "unterminated_tail": {
            "type": "boolean"
          }
        }
      }
    },
    "pod_list_error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
